MAF_MYSQL_HOST=127.0.0.1
MAF_MYSQL_PORT=3306
MAF_MYSQL_USER=maf_app
MAF_MYSQL_PASSWORD=maf_password_change_me
MAF_MYSQL_DATABASE=multiple_agent_finance

# Base LLM for all agents.
# Keep the real key in local .env only. Do not commit secrets.
MAF_LLM_PROVIDER=volcengine_ark
MAF_LLM_MODEL=deepseek-v4-flash
# Volcengine Ark may require an endpoint id in the OpenAI-compatible `model` field.
# If live checks return InvalidEndpointOrModel.NotFound, set this to the endpoint id
# shown in the Ark console. Leave empty to use MAF_LLM_MODEL directly.
MAF_LLM_ENDPOINT_ID=
MAF_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
MAF_LLM_API_KEY=
MAF_LLM_TEMPERATURE=0.2
MAF_LLM_TIMEOUT=60
